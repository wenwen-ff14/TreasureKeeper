<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PlatformTarget>x64</PlatformTarget>
    <DalamudLibPath Condition="'$(DalamudLibPath)' == ''">$(MSBuildThisFileDirectory)../../../CrescentCompass/.sdk/</DalamudLibPath>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../TreasureKeeper.Core/TreasureKeeper.Core.csproj" />
    <Compile Include="../../TreasureKeeper/Ui/*.cs" Link="Ui/%(Filename)%(Extension)" />
    <Reference Include="Dalamud.Bindings.ImGui"><HintPath>$(DalamudLibPath)/Dalamud.Bindings.ImGui.dll</HintPath></Reference>
    <Reference Include="HexaGen.Runtime"><HintPath>$(DalamudLibPath)/HexaGen.Runtime.dll</HintPath></Reference>
    <None Include="$(DalamudLibPath)/cimgui.dll" Link="cimgui.dll" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../TreasureKeeper/Data/catalog.json" Link="catalog.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="map-items.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
